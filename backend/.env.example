PORT=3001
FRONTEND_URL=http://localhost:5173

# Supabase — app.supabase.com > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# CoinGecko — API pública, no requiere key en plan gratuito
COINGECKO_BASE=https://api.coingecko.com/api/v3

# Gemini — https://aistudio.google.com/app/apikey (free tier subject to limits)
GEMINI_API_KEY=tu_gemini_key_aqui
# Optional numbered keys are also supported: GEMINI_API_KEY_1 through _7

# Groq — https://console.groq.com/keys (free tier subject to limits)
GROQ_API_KEY=tu_groq_key_aqui
# Optional; served by Groq. No OpenAI API key is used.
GROQ_MODEL=openai/gpt-oss-20b
